# PennyFlow environment variables
#
# Cloud sync + Google sign-in are OPTIONAL. Without these the app runs
# fully local (IndexedDB only). To enable sync, create a Supabase project
# and fill these in, then copy this file to `.env.local`.
#
#   cp .env.example .env.local
#
# Both values come from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
