# PennyFlow environment variables
#
# Cloud sync + Google sign-in are OPTIONAL. Without these the app runs
# fully local (IndexedDB only). To enable sync, create a Supabase project
# and fill these in, then copy this file to `.env.local`.
#
#   cp .env.example .env.local
#
# Both values come from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Automated bank / UPI import (Account Aggregator) — server-side only.
# NEVER prefix these with NEXT_PUBLIC_. Full guide: docs/FINANCIAL_INTEGRATION.md
# ---------------------------------------------------------------------------
# Consent registry (required in production). Service-role key bypasses RLS: keep it secret.
# SUPABASE_SERVICE_ROLE_KEY=
# Public origin used for the post-consent redirect (recommended behind a proxy, e.g. https://app.example.com)
# PENNYFLOW_APP_URL=
# Sandbox provider (generated test data). On by default outside production; off in production
# unless set to true. Leave unset/false in production.
# PENNYFLOW_ENABLE_MOCK_AA=true
# Real provider credentials — only once onboarded as / through an FIU (see docs). Adapters are not implemented yet.
# SETU_CLIENT_ID=
# SETU_CLIENT_SECRET=
# SETU_PRODUCT_INSTANCE_ID=
